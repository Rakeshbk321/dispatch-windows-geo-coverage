      "updated": 1,
      "link": null,
      "locked": false,
      "text": "tryReserve(windowId):\n   UPDATE dispatch_window SET booked_count = booked_count + 1 WHERE id = :windowId AND booked_count < capacity\nreleaseSeatOf(bookingId):\n   UPDATE dispatch_window SET booked_count = booked_count - 1 WHERE id = (SELECT window_id FROM booking WHERE id = :bookingId)\ncancelIfConfirmed(id, now):\n   UPDATE booking SET status = 'CANCELLED', cancelled_at = :now WHERE id = :id AND status = 'CONFIRMED'",
      "originalText": "tryReserve(windowId):\n   UPDATE dispatch_window SET booked_count = booked_count + 1 WHERE id = :windowId AND booked_count < capacity\nreleaseSeatOf(bookingId):\n   UPDATE dispatch_window SET booked_count = booked_count - 1 WHERE id = (SELECT window_id FROM booking WHERE id = :bookingId)\ncancelIfConfirmed(id, now):\n   UPDATE booking SET status = 'CANCELLED', cancelled_at = :now WHERE id = :id AND status = 'CONFIRMED'",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
